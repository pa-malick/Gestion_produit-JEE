							"query": [
								{
									"key": "categorie",
									"value": "Informatique"
								}
							]
						}
					}
				}
			]
		},
		{
			"name": "3 - Cas d erreur",
			"item": [
				{
					"name": "Produit inexistant (404)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Statut 404\", function () {",
									"    pm.response.to.have.status(404);",
									"});",
									"pm.test(\"Le message d erreur est renseigne\", function () {",
									"    pm.expect(pm.response.json().message).to.be.a(\"string\");",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
